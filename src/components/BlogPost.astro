---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogHref } from '../lib/blog';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — Mindscaper`} description={post.data.description} canonicalPath={blogHref(post.id)} containerClass="container blog-post">
	<article>
		<a class="blog-back" href={blogHref()}>← All posts</a>
		<header>
			<time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
			<h1>{post.data.title}</h1>
			<p>{post.data.description}</p>
		</header>
		<div class="blog-prose"><Content /></div>
		<a class="blog-back blog-post-end" href={blogHref()}>← All posts</a>
	</article>
</BaseLayout>
