---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
---

<BaseLayout title="Page not found — Mindscaper" description="This page could not be found." canonicalPath="/404.html" noindex>
	<header class="subpage-header">
		<div class="container header-inner">
			<a class="brand-link" href="/" aria-label="Mindscaper — Home"><BrandMark /></a>
			<nav class="subpage-nav" aria-label="Main navigation">
				<a href="/#projects">Projects</a>
				<a href="/#about">About</a>
				<a href="/join/">Get involved</a>
				<a href="/blog/">Blog</a>
			</nav>
		</div>
	</header>
	<main id="main" class="not-found">
		<div class="container">
			<h1>Page not found</h1>
			<p>The page you were looking for is not here.</p>
			<a href="/">Go to the homepage</a>
		</div>
	</main>
</BaseLayout>
