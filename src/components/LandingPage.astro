---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from './BrandMark.astro';
import { siteCopy, type Locale } from '../i18n/content';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = siteCopy[locale];
const year = new Date().getFullYear();
---

<BaseLayout
	lang={locale}
	title={copy.meta.title}
	description={copy.meta.description}
	canonicalPath={locale === 'de' ? '/de/' : '/'}
	enPath="/"
	dePath="/de/"
>
	<header class="site-header">
		<div class="container header-inner">
			<a class="brand-link" href={locale === 'de' ? '/de/' : '/'} aria-label="Mindscaper — Home">
				<BrandMark />
			</a>
			<nav class="main-nav" aria-label={copy.nav.ariaLabel}>
				<a href="#mission">{copy.nav.mission}</a>
				<a href="#projects">{copy.nav.projects}</a>
				<a href={locale === 'de' ? '/de/join/' : '/join/'}>{copy.nav.join}</a>
				<a href={locale === 'de' ? '/de/blog/' : '/blog/'}>{copy.nav.blog}</a>
			</nav>
			<a class="language-switch" href={copy.language.href} lang={locale === 'de' ? 'en' : 'de'} hreflang={locale === 'de' ? 'en' : 'de'}>
				<span class="language-long">{copy.language.label}</span>
				<span class="language-short" aria-hidden="true">{copy.language.short}</span>
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m5 3 5 5-5 5" /></svg>
			</a>
		</div>
	</header>

	<main id="main">
		<section class="hero section-pad">
			<div class="container hero-grid">
				<div class="hero-copy">
					<p class="eyebrow"><span></span>{copy.hero.eyebrow}</p>
					<h1>{copy.hero.titleStart} <em>{copy.hero.titleAccent}</em></h1>
					<p class="hero-intro">{copy.hero.intro}</p>
					<div class="button-row">
						<a class="button button-primary" href="https://github.com/LeoWattenberg/Soundscaper">
							{copy.hero.primaryCta}
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
						</a>
						<a class="button button-text" href="#projects">{copy.hero.secondaryCta}</a>
					</div>
				</div>

				<div class="hero-art" role="img" aria-label={copy.hero.artLabel}>
					<div class="hero-art-grid" aria-hidden="true"></div>
					<div class="frame frame-one" aria-hidden="true"><span></span></div>
					<div class="frame frame-two" aria-hidden="true"><span></span></div>
					<svg class="hero-wave" viewBox="0 0 560 240" aria-hidden="true" preserveAspectRatio="none">
						<path class="wave-shadow" d="M0 124c29 0 29-24 58-24s29 62 58 62 29-117 58-117 29 151 58 151 29-181 58-181 29 159 58 159 29-102 58-102 29 58 58 58 29-21 58-21 29 15 58 15" />
						<path d="M0 124c29 0 29-24 58-24s29 62 58 62 29-117 58-117 29 151 58 151 29-181 58-181 29 159 58 159 29-102 58-102 29 58 58 58 29-21 58-21 29 15 58 15" />
					</svg>
					<div class="play-dot" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5Z" /></svg>
					</div>
					<p>{copy.hero.artCaption}</p>
				</div>
			</div>
		</section>

		<section class="mission section-pad" id="mission">
			<div class="container">
				<div class="section-heading mission-heading">
					<p class="eyebrow eyebrow-light"><span></span>{copy.mission.eyebrow}</p>
					<div>
						<h2>{copy.mission.title}</h2>
						<p>{copy.mission.body}</p>
					</div>
				</div>

				<ol class="principles">
					{copy.mission.principles.map((principle) => (
						<li>
							<span class="principle-number">{principle.number}</span>
							<div class="principle-icon" aria-hidden="true"><span></span><span></span><span></span></div>
							<h3>{principle.title}</h3>
							<p>{principle.body}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<section class="projects section-pad" id="projects">
			<div class="container">
				<div class="section-heading projects-heading">
					<div>
						<p class="eyebrow"><span></span>{copy.projects.eyebrow}</p>
						<h2>{copy.projects.title}</h2>
					</div>
					<p>{copy.projects.intro}</p>
				</div>

				<div class="project-grid">
					{copy.projects.items.map((project, index) => (
						<article class:list={['project-card', index === 0 ? 'project-audio' : 'project-video']}>
							<div class="project-visual" role="img" aria-label={project.visualLabel}>
								{index === 0 ? (
									<svg class="audio-visual" viewBox="0 0 640 280" aria-hidden="true" preserveAspectRatio="none">
										<g class="audio-grid">
											<path d="M0 40h640M0 100h640M0 160h640M0 220h640" />
											<path d="M80 0v280M160 0v280M240 0v280M320 0v280M400 0v280M480 0v280M560 0v280" />
										</g>
										<path class="audio-wave-back" d="M0 141 20 132l18 22 18-55 18 104 18-70 18 16 18-102 18 171 18-81 18 42 18-93 18 80 18-36 18 11 18-70 18 123 18-61 18 36 18-94 18 78 18-20 18 5 18-60 18 98 18-55 18 28 18-78 18 62 18-17 18 2 18-40 18 66 18-35 18 11 18-44 18 34 20-7" />
										<path class="audio-wave" d="M0 141 20 132l18 22 18-55 18 104 18-70 18 16 18-102 18 171 18-81 18 42 18-93 18 80 18-36 18 11 18-70 18 123 18-61 18 36 18-94 18 78 18-20 18 5 18-60 18 98 18-55 18 28 18-78 18 62 18-17 18 2 18-40 18 66 18-35 18 11 18-44 18 34 20-7" />
									</svg>
								) : (
									<div class="video-visual" aria-hidden="true">
										<div class="video-frame frame-back"><span></span></div>
										<div class="video-frame frame-front"><span></span><i></i></div>
										<div class="timeline"><b></b><b></b><b></b><b></b><b></b><b></b></div>
									</div>
								)}
							</div>
							<div class="project-content">
								<p class="project-kind">{project.kind}</p>
								<h3>{project.name}</h3>
								<p>{project.description}</p>
								<a class="project-link" href={project.href}>
									{copy.projects.visitLabel} {project.name}
									<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
								</a>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="join section-pad" id="join">
			<div class="container join-card">
				<div class="join-main">
					<p class="eyebrow eyebrow-light"><span></span>{copy.join.eyebrow}</p>
					<h2>{copy.join.title}</h2>
					<p>{copy.join.body}</p>
					<ul class="role-list" aria-label={locale === 'de' ? 'Möglichkeiten mitzumachen' : 'Ways to contribute'}>
						{copy.join.roles.map((role) => <li>{role}</li>)}
					</ul>
					<a class="button button-light" href={locale === 'de' ? '/de/join/' : '/join/'}>
						{copy.join.cta}
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
					</a>
				</div>
				<div class="join-aside" aria-hidden="true">
					<div class="join-mark"><BrandMark label="" /></div>
					<p>{copy.join.aside}</p>
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="container footer-grid">
			<div class="footer-brand">
				<a class="brand-link brand-link-footer" href={locale === 'de' ? '/de/' : '/'} aria-label="Mindscaper — Home">
					<BrandMark />
				</a>
				<p>{copy.footer.tagline}<br />{copy.footer.status}</p>
			</div>
			<div class="footer-column">
				<h2>{copy.footer.projects}</h2>
				<a href="https://soundscaper.org">Soundscaper</a>
				<a href="https://framescaper.org">Framescaper</a>
			</div>
			<div class="footer-column">
				<h2>{copy.footer.connect}</h2>
				<a href="https://github.com/LeoWattenberg/Soundscaper">{copy.footer.github}</a>
				<a href="https://github.com/LeoWattenberg/mindscaper.org">{copy.footer.source}</a>
				<a href={copy.footer.legalHref}>{copy.footer.legal}</a>
				<a href={locale === 'de' ? '/de/blog/' : '/blog/'}>{copy.nav.blog}</a>
			</div>
		</div>
		<div class="container footer-bottom">
			<p>© {year} Mindscaper</p>
			<p>Sound · Frame · Freedom</p>
		</div>
	</footer>
</BaseLayout>
