---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Mindscaper — Creative software, built in the open"
    description="Mindscaper is a non-profit association and open source project making creative tools for sound and video."
    canonicalPath="/"
    headerVariant="home"
    mainClass={null}
    containerClass={null}
>
    <section class="hero">
        <div class="container hero-inner">
            <h1>Let's build our own<br /><span>creative software.</span></h1>
            <div class="hero-bottom">
                <p>
                    Mindscaper is a non-profit association of creative people
                    making tools for creative uses.
                </p>
                <a class="text-link" href="#projects"
                    >Explore the projects <span aria-hidden="true">↓</span></a
                >
            </div>
        </div>
    </section>

    <section
        class="projects section-pad"
        id="projects"
        aria-labelledby="projects-heading"
    >
        <div class="container">
            <div class="section-intro">
                <h2 id="projects-heading">Our projects</h2>
                <p>
                    Two creative workspaces, built from the same open source
                    foundation.
                </p>
            </div>

            <article class="project-row">
                <div class="project-copy">
                    <h3><img src="/logos/soundscaper.svg" width="56" height="56" alt="" aria-hidden="true" />Soundscaper</h3>
                    <p>
                        Record, edit, and mix audio in your browser. Your
                        projects stay on your device.
                    </p>
                    <div class="project-links">
                        <a class="text-link" href="https://soundscaper.org"
                            >Explore Soundscaper <span aria-hidden="true"
                                >↗</span
                            ></a
                        >
                        <a
                            class="secondary-link"
                            href="https://github.com/LeoWattenberg/Soundscaper"
                            >Source code <span aria-hidden="true">↗</span></a
                        >
                    </div>
                </div>
                <figure class="project-figure">
                    <picture>
                        <source
                            media="(max-width: 600px)"
                            srcset="/screenshots/soundscaper-narrow.png"
                        />
                        <img
                            src="/screenshots/soundscaper-wide.png"
                            width="1280"
                            height="800"
                            loading="lazy"
                            alt="Soundscaper audio editor with tracks and an open project"
                        />
                    </picture>
                    <figcaption>Soundscaper interface</figcaption>
                </figure>
            </article>

            <article class="project-row">
                <div class="project-copy">
                    <h3><img src="/logos/framescaper.svg" width="56" height="56" alt="" aria-hidden="true" />Framescaper</h3>
                    <p>
                        Edit video, effects, and compositions in a focused
                        workspace. Move projects between the two tools.
                    </p>
                    <div class="project-links">
                        <a class="text-link" href="https://framescaper.org"
                            >Explore Framescaper <span aria-hidden="true"
                                >↗</span
                            ></a
                        >
                        <a
                            class="secondary-link"
                            href="https://github.com/LeoWattenberg/Soundscaper"
                            >Source code <span aria-hidden="true">↗</span></a
                        >
                    </div>
                </div>
                <figure class="project-figure">
                    <picture>
                        <source
                            media="(max-width: 600px)"
                            srcset="/screenshots/framescaper-narrow.png"
                        />
                        <img
                            src="/screenshots/framescaper-wide.png"
                            width="1280"
                            height="800"
                            loading="lazy"
                            alt="Framescaper video editor with preview and timeline"
                        />
                    </picture>
                    <figcaption>Framescaper interface</figcaption>
                </figure>
            </article>
        </div>
    </section>

    <section
        class="future section-pad"
        id="future"
        aria-labelledby="future-heading"
    >
        <div class="container future-grid">
            <h2 id="future-heading">Future projects</h2>
            <div class="future-copy">
                <p>
                    Our current focus is on audio/video production as that's
                    our founding member's background.
                </p>
                <p>
                    In the future, we'll branch out into other areas too. If
                    you wanted to get a free, open-source tool for your own
                    creative area, join now, no coding required.
                </p>
                <div class="future-links">
                    <a class="text-link" href="/join/"
                        >Join us<span aria-hidden="true">↗</span></a
                    >
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
