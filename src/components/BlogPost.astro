---
import { render, type CollectionEntry } from 'astro:content';
import BlogShell from './BlogShell.astro';
import { blogHref } from '../lib/blog';
import type { Locale } from '../i18n/content';

interface Props { post: CollectionEntry<'blog'>; locale: Locale }
const { post, locale } = Astro.props;
const { Content } = await render(post);
const back = locale === 'de' ? 'Alle Beiträge' : 'All posts';
---

<BlogShell locale={locale} title={`${post.data.title} — Mindscaper`} description={post.data.description} canonicalPath={blogHref(locale, post.id)}>
	<article class="blog-post container">
		<a class="blog-back" href={blogHref(locale)}>← {back}</a>
		<header>
			<time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString(locale === 'de' ? 'de-DE' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
			<h1>{post.data.title}</h1>
			<p>{post.data.description}</p>
		</header>
		<div class="blog-prose"><Content /></div>
		<a class="blog-back blog-post-end" href={blogHref(locale)}>← {back}</a>
	</article>
</BlogShell>
