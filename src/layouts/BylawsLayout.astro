---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout
	title={frontmatter.title}
	description={frontmatter.description}
	canonicalPath="/bylaws/"
	headerVariant="back"
>

	<main id="main" class="container bylaws-layout">
		<article class="bylaws-content">
			<slot />
		</article>
	</main>
</BaseLayout>

<style>
	.bylaws-layout {
		max-width: 58rem;
		padding-block: clamp(3rem, 7vw, 6rem);
	}

	.bylaws-content :global(h1) {
		margin-bottom: 3.5rem;
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1.05;
	}

	.bylaws-content :global(h2) {
		margin-top: 3.25rem;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.12;
	}

	.bylaws-content :global(h3) {
		margin-top: 2rem;
		font-size: 1.25rem;
		line-height: 1.3;
	}

	.bylaws-content :global(p),
	.bylaws-content :global(ol),
	.bylaws-content :global(ul) {
		margin-top: 1rem;
		color: var(--ink-soft);
		line-height: 1.75;
	}

	.bylaws-content :global(ol),
	.bylaws-content :global(ul) {
		padding-left: 1.5rem;
	}

	.bylaws-content :global(li + li) {
		margin-top: 0.5rem;
	}

	.bylaws-content :global(.table-wrap) {
		margin-top: 1.5rem;
		overflow-x: auto;
	}

	.bylaws-content :global(table) {
		width: 100%;
		border-collapse: collapse;
		background: var(--paper-bright);
		line-height: 1.5;
	}

	.bylaws-content :global(th),
	.bylaws-content :global(td) {
		min-width: 10rem;
		padding: 1rem;
		border: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}

	.bylaws-content :global(th) {
		background: var(--paper-muted);
		color: var(--ink);
	}

	@media (max-width: 620px) {
		.bylaws-layout {
			width: min(100% - 2rem, 58rem);
		}
	}
</style>