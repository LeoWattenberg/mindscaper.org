---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Get involved — Mindscaper" description="Join the Mindscaper community or contribute to its open source projects." canonicalPath="/join/" activePage="join">
	<main id="main" class="page-main">
		<div class="container">
			<header class="page-intro">
				<h1>Get involved</h1>
				<p>Mindscaper is an open source project. You can join the conversation, try the tools, or help build them.</p>
			</header>
			<ul class="join-links">
				<li>
					<h2>Talk with the community</h2>
					<p>Share ideas and questions on our forum.</p>
					<a href="https://mindscaper.discourse.group/">Visit the forum ↗</a>
				</li>
				<li>
					<h2>Contribute code</h2>
					<p>Explore Soundscaper’s source, report issues, and contribute on GitHub.</p>
					<a href="https://github.com/LeoWattenberg/Soundscaper">View Soundscaper on GitHub ↗</a>
				</li>
			</ul>
		</div>
	</main>
	<footer class="site-footer">
		<div class="container footer-inner">
			<p>© {new Date().getFullYear()} Mindscaper</p>
			<nav aria-label="Footer navigation">
				<a href="/">Home</a>
				<a href="/legal/">Legal & privacy</a>
			</nav>
		</div>
	</footer>
</BaseLayout>
