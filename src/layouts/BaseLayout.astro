---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
	noindex?: boolean;
	headerVariant?: 'home' | 'subpage' | 'back';
	activePage?: 'join' | 'blog';
	showFooter?: boolean;
	mainClass?: string | null;
	containerClass?: string | null;
}

const { title, description, canonicalPath, noindex = false, headerVariant = 'subpage', activePage, showFooter = true, mainClass = 'page-main', containerClass = 'container' } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#fcfaf7" />
		<meta name="color-scheme" content="light" />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:site_name" content="Mindscaper" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader variant={headerVariant} activePage={activePage} />
		<main id="main" class={mainClass}>
			<div class={containerClass}><slot /></div>
		</main>
		{showFooter && (
			<footer class="site-footer">
				<div class="container footer-inner">
					<p>© {new Date().getFullYear()} Mindscaper</p>
					<nav aria-label="Footer navigation">
						{headerVariant === 'home' ? (
							<>
								<a href="/join/">Get involved</a>
								<a href="/blog/">Blog</a>
								<a href="/legal/">Legal &amp; privacy</a>
								<a href="https://github.com/LeoWattenberg/mindscaper.org">Website source</a>
							</>
						) : (
							<>
								<a href="/">Home</a>
								<a href="/legal/" aria-current={canonicalPath === '/legal/' ? 'page' : undefined}>Legal &amp; privacy</a>
							</>
						)}
					</nav>
				</div>
			</footer>
		)}
	</body>
</html>
