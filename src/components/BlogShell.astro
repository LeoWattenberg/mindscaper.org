---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
	index?: boolean;
}

const { title, description, canonicalPath, index = false } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} activePage={index ? 'blog' : undefined}>
	<main id="main" class="page-main"><slot /></main>
	<footer class="site-footer">
		<div class="container footer-inner">
			<p>© {new Date().getFullYear()} Mindscaper</p>
			<nav aria-label="Footer navigation">
				<a href="/">Home</a>
				<a href="/legal/">Legal & privacy</a>
			</nav>
		</div>
	</footer>
</BaseLayout>
