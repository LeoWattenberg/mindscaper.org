---
import { BaseLayout } from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Join us — Mindscaper" description="Join the Mindscaper community or contribute to its open source projects." canonicalPath="/join/" activePage="join">
	<header class="page-intro">
		<h1>Join us</h1>
		<p>We're a community of content creators who want creative tools that make our lives easier and decided to take matters into our own hands. You can become part of it.</p>
	</header>
	<ul class="join-links">
		<li>
			<h2>Join the community</h2>
			<p>Ideas, questions, rants, future discussions and more - this is our primary meeting place.</p>
			<a href="https://mindscaper.discourse.group/invites/WBRznV7teD">Join now</a>
		</li>
		<li>
			<h2>Contribute</h2>
			<p>Explore Soundscaper’s source, report issues, and contribute on GitHub.</p>
			<a href="https://github.com/LeoWattenberg/Soundscaper">View Soundscaper on GitHub</a>
		</li>
	</ul>
</BaseLayout>
