---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogHref, getPublishedPosts } from '../lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog — Mindscaper" description="News and notes from Mindscaper." canonicalPath={blogHref()} activePage="blog">
	<header class="page-intro">
		<h1>Blog</h1>
		<p>News and notes from Mindscaper.</p>
	</header>
	{posts.length === 0 ? (
		<p>Posts will appear here soon.</p>
	) : (
		<ol class="post-list">
			{posts.map((post) => (
				<li>
					<article class="post-summary">
						<time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
						<h2><a href={blogHref(post.id)}>{post.data.title}</a></h2>
						<p>{post.data.description}</p>
					</article>
				</li>
			))}
		</ol>
	)}
</BaseLayout>
