---
interface Props {
	label?: string;
}

const { label = 'Mindscaper' } = Astro.props;
const decorative = label.length === 0;
---

<span class="brand-lockup">
	<svg
		class="brand-mark"
		viewBox="0 0 100 100"
		role={decorative ? undefined : 'img'}
		aria-label={decorative ? undefined : label}
		aria-hidden={decorative ? 'true' : undefined}
	>
		<circle cx="49" cy="31" r="19" fill="#FF964D" />
		<path d="M73.3154 86.25H25.6846L44.5518 53.5684C45.991 53.8504 47.4781 54 49 54C50.837 54 52.6234 53.7828 54.3359 53.376L73.3154 86.25Z" fill="#6900FF" />
	</svg>
	<span class="brand-name" aria-hidden="true">Mindscaper</span>
</span>
